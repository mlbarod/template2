# Airflow DAG 공통 환경 변수입니다.
# Airflow runtime 설정이 아니라 DAG task/API trigger/callback에서 읽는 값만 둡니다.

# --- API trigger --------------------------------------------------------------
# Airflow DAG가 Django API trigger endpoint를 호출할 때 사용합니다.
AIRFLOW_API_BASE_URL=http://api:8000
AIRFLOW_TRIGGER_TOKEN=5ca99f0ae7b1fcd3f958ebb1c2ee4639d0a8fada21e8ff009d27f42cd2bbf31e

# --- Airflow task 실패 알림 (Knox Messenger) --------------------------------
# 비어 있으면 실패 알림 callback은 조용히 스킵합니다.
KNOX_MESSENGER_API_BASE_URL=
KNOX_MESSENGER_AUTHORIZATION=
KNOX_MESSENGER_SYSTEM_ID=
AIRFLOW_FAILURE_ALERT_KNOX_IDS=

# 선택 override는 필요할 때만 주석을 해제합니다.
# KNOX_MESSENGER_TIMEOUT_SECONDS=10
# AIRFLOW_FAILURE_ALERT_CHATROOM_TITLE=Airflow 실패 알림
# AIRFLOW_FAILURE_ALERT_CHATROOM_ID_FILE=/tmp/airflow_failure_alert_chatroom_id.json
# AIRFLOW_FAILURE_ALERT_MESSAGE_TTL=7200

# --- DAG 동시 실행 제한 -------------------------------------------------------
# 모든 DAG task가 공유하는 Airflow pool 이름과 slot 수입니다.
# AIRFLOW_DAG_SHARED_POOL=shared_dag_concurrency_pool
# AIRFLOW_DAG_SHARED_POOL_SLOTS=3
